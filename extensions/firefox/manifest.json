{
  "manifest_version": 3,
  "name": "Rustune Apple Music Bridge",
  "version": "0.1.0",
  "description": "Control your signed-in Apple Music tab from the local Rustune TUI. No cookie or token access.",
  "browser_specific_settings": {"gecko": {"id": "rustune@rustune.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}},
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://music.apple.com/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_title": "Connect Rustune to Apple Music"}
}
