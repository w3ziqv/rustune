# Development starting point only; not submitted to AUR.
pkgname=rustune-git
pkgver=0.5.0.r0
pkgrel=1
pkgdesc='Experimental Apple Music TUI controller for Linux'
arch=('x86_64')
url='https://github.com/w3ziqv/rustune'
license=('MIT')
depends=('gcc-libs' 'glibc' 'dbus' 'alsa-lib' 'openssl' 'ffmpeg>=9')
makedepends=('rust>=1.99' 'git' 'clang' 'pkgconf' 'make' 'python')
source=('rustune::git+https://github.com/w3ziqv/rustune.git#branch=main')
sha256sums=('SKIP')
prepare() {
  cd "$srcdir/rustune"
  cargo fetch --locked
}
build() {
  cd "$srcdir/rustune"
  cargo build --frozen --release
}
check() {
  cd "$srcdir/rustune"
  cargo test --frozen
}
package() {
  cd "$srcdir/rustune"
  install -Dm755 target/release/rustune "$pkgdir/usr/bin/rustune"
  install -Dm755 target/release/rustune-audio "$pkgdir/usr/bin/rustune-audio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
